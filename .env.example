# ============================================================================
# K4 Track 3B — Day 24 Eval + Guardrail Stack
# Copy this file to `.env` and fill in the key. `.env` is git-ignored:
# never commit a real key, and never paste one into source, logs or reports.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
# ============================================================================

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# Google AI Studio key for the Gemini free tier (required).
# Leave OPENAI_API_KEY empty when using GEMINI_API_KEY.
GEMINI_API_KEY=

# Optional alternative: any OpenAI-compatible provider key. When GEMINI_API_KEY
# is empty this value is used instead, so Day 18 modules keep working.
OPENAI_API_KEY=

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=

# ---------------------------------------------------------------------------
# Endpoint
# ---------------------------------------------------------------------------
# Gemini's OpenAI-compatible surface (default). Point this elsewhere to use any
# other OpenAI-compatible gateway; the whole project then follows that provider.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Preferred free-tier model. If the account does not expose it, run
#   python scripts/check_api.py --list-models
# and set a model ID that IS available (for example gemini-2.5-flash-lite).
GENERATION_MODEL=gemini-3.5-flash-lite

# Judge used by pairwise A/B and the 0/1 calibration helper.
JUDGE_MODEL=gemini-3.5-flash-lite

# Evaluator LLM for the Phase A metrics (m4). Defaults to JUDGE_MODEL.
EVALUATOR_MODEL=

# ---------------------------------------------------------------------------
# Free-tier pacing and retry
# ---------------------------------------------------------------------------
# Concurrency and minimum delay are tuned for the free tier. Raise both only if
# the account has higher quota.
LLM_MAX_CONCURRENCY=2
LLM_MIN_INTERVAL_S=4.0
# Exponential backoff applied to HTTP 429 / 5xx before giving up.
LLM_MAX_RETRIES=6
LLM_RETRY_BASE_DELAY_S=4.0
LLM_RETRY_MAX_DELAY_S=90.0
LLM_TIMEOUT_S=120.0

# ---------------------------------------------------------------------------
# Local retrieval stack (no API quota)
# ---------------------------------------------------------------------------
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# RERANK_TOP_K=3

# ---------------------------------------------------------------------------
# PII guardrails
# ---------------------------------------------------------------------------
# Presidio base language; Vietnamese CCCD/CMND and phone recognizers are added
# as custom pattern recognizers, so the base language stays `en`.
# PRESIDIO_LANGUAGE is defined in config.py.
